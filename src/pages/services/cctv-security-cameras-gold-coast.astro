---
import { getCctvContent } from '../../lib/content-client';
import ActiveDeterrenceShowcase from '../../components/cctv-security-cameras-gold-coast/ActiveDeterrenceShowcase.astro';
import Faq from '../../components/cctv-security-cameras-gold-coast/Faq.astro';
import FeaturedAwards from '../../components/cctv-security-cameras-gold-coast/FeaturedAwards.astro';
import Footer from '../../components/cctv-security-cameras-gold-coast/Footer.astro';
import Header from '../../components/cctv-security-cameras-gold-coast/Header.astro';
import Hero from '../../components/cctv-security-cameras-gold-coast/Hero.astro';
import Inclusions from '../../components/cctv-security-cameras-gold-coast/Inclusions.astro';
import InstallerProfile from '../../components/cctv-security-cameras-gold-coast/InstallerProfile.astro';
import LocalCaseStudy from '../../components/cctv-security-cameras-gold-coast/LocalCaseStudy.astro';
import MasterCablerSection from '../../components/cctv-security-cameras-gold-coast/MasterCablerSection.astro';
import MobileAppViewer from '../../components/cctv-security-cameras-gold-coast/MobileAppViewer.astro';
import PricingPackages from '../../components/cctv-security-cameras-gold-coast/PricingPackages.astro';
import ProcessSteps from '../../components/cctv-security-cameras-gold-coast/ProcessSteps.astro';
import QuoteForm from '../../components/cctv-security-cameras-gold-coast/QuoteForm.astro';
import Reviews from '../../components/cctv-security-cameras-gold-coast/Reviews.astro';
import ServicesGrid from '../../components/cctv-security-cameras-gold-coast/ServicesGrid.astro';
import GoldCoastServiceArea from '../../components/cctv-security-cameras-gold-coast/GoldCoastServiceArea.astro';
import SuburbGrid from '../../components/cctv-security-cameras-gold-coast/SuburbGrid.astro';
import SystemComparison from '../../components/cctv-security-cameras-gold-coast/SystemComparison.astro';
import TrustBadges from '../../components/cctv-security-cameras-gold-coast/TrustBadges.astro';
import WomBadges from '../../components/cctv-security-cameras-gold-coast/WomBadges.astro';
import CctvLayout from '../../layouts/CctvLayout.astro';

const content = await getCctvContent('gold-coast');
---

<CctvLayout
  title={content.seo.title}
  description={content.seo.description}
>
  <Header />
  <Hero
    heading={content.hero.heading}
    description={content.hero.description}
    suburb={content.site.suburb}
  />
  <TrustBadges />
  <MasterCablerSection />
  <FeaturedAwards />
  <ServicesGrid />
  <ActiveDeterrenceShowcase />
  <MobileAppViewer />
  <Inclusions />
  <SystemComparison />
  <PricingPackages />
  <ProcessSteps />
  <LocalCaseStudy />
  <InstallerProfile />
  <Reviews />
  <SuburbGrid />
  <Faq />
  <QuoteForm />
  <WomBadges />
  <GoldCoastServiceArea />
  <Footer />
</CctvLayout>
