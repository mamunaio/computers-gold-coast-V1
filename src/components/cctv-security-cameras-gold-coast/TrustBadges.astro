---
// Component: TrustBadges.astro for Computers Gold Coast
---
<section class="py-12 bg-white dark:bg-slate-900/40 border-y border-slate-200 dark:border-white/10 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      
      <!-- Badge 1: QLD Security Licence -->
      <div class="glass-box p-5 rounded-2xl border border-slate-200 dark:border-white/10 flex flex-col justify-between hover:-translate-y-1 transition-transform">
        <div class="flex items-center justify-between mb-3">
          <span class="text-2xl">🛡️</span>
          <span class="px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 font-mono text-[10px] font-bold border border-emerald-300 dark:border-emerald-500/20">
            QLD LICENSED
          </span>
        </div>
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Security Licence</div>
          <div class="text-base sm:text-lg font-black text-slate-900 dark:text-white mt-0.5 font-mono">#4481646</div>
          <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">Class 1 &amp; 2 Security Firm and Security Installer under QLD Police Service.</p>
        </div>
      </div>

      <!-- Badge 2: ACMA Master Cabler -->
      <div class="glass-box p-5 rounded-2xl border border-slate-200 dark:border-white/10 flex flex-col justify-between hover:-translate-y-1 transition-transform">
        <div class="flex items-center justify-between mb-3">
          <span class="text-2xl">🔌</span>
          <span class="px-2 py-0.5 rounded-md bg-blue-50 dark:bg-blue-500/10 text-blue-700 dark:text-blue-400 font-mono text-[10px] font-bold border border-blue-300 dark:border-blue-500/20">
            ACMA OPEN
          </span>
        </div>
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Master Cabler</div>
          <div class="text-base sm:text-lg font-black text-slate-900 dark:text-white mt-0.5 font-mono">#A038720</div>
          <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">Open Registration with Cat6 structured cabling and coaxial endorsements.</p>
        </div>
      </div>

      <!-- Badge 3: Public Liability Insurance -->
      <div class="glass-box p-5 rounded-2xl border border-slate-200 dark:border-white/10 flex flex-col justify-between hover:-translate-y-1 transition-transform">
        <div class="flex items-center justify-between mb-3">
          <span class="text-2xl">📜</span>
          <span class="px-2 py-0.5 rounded-md bg-cyan-50 dark:bg-cyan-500/10 text-cyan-700 dark:text-cyan-400 font-mono text-[10px] font-bold border border-cyan-300 dark:border-cyan-500/20">
            ACTIVE COVER
          </span>
        </div>
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Public Liability</div>
          <div class="text-base sm:text-lg font-black text-slate-900 dark:text-white mt-0.5 font-mono">$20,000,000</div>
          <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">Complete commercial insurance cover for residential homes, holiday rentals, and venues.</p>
        </div>
      </div>

      <!-- Badge 4: Dual Warranty -->
      <div class="glass-box p-5 rounded-2xl border border-slate-200 dark:border-white/10 flex flex-col justify-between hover:-translate-y-1 transition-transform">
        <div class="flex items-center justify-between mb-3">
          <span class="text-2xl">🤝</span>
          <span class="px-2 py-0.5 rounded-md bg-purple-50 dark:bg-purple-500/10 text-purple-700 dark:text-purple-400 font-mono text-[10px] font-bold border border-purple-300 dark:border-purple-500/20">
            GUARANTEE
          </span>
        </div>
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Warranty Package</div>
          <div class="text-base sm:text-lg font-black text-slate-900 dark:text-white mt-0.5">3-Yr HW + 5-Yr Cabling</div>
          <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">Official manufacturer replacement warranty plus written cabling workmanship guarantee.</p>
        </div>
      </div>

    </div>
  </div>
</section>
