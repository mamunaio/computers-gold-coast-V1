---
// Component: SuburbGrid.astro for Computers Gold Coast
---
<section class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="text-xs font-black text-blue-600 dark:text-cyan-400 uppercase tracking-widest px-3.5 py-1 rounded-full bg-blue-50 dark:bg-blue-950/50 border border-blue-200 dark:border-blue-800/50">
        Gold Coast Coverage
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white mt-3 tracking-tight uppercase">
        CCTV Installation Across Gold Coast
      </h2>
      <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base mt-2">
        Restrained local grid across Surfers Paradise, Southport and surrounding Gold Coast coastal &amp; hinterland suburbs. Fast mobile dispatch with zero travel surcharges.
      </p>

      <!-- Search input for suburbs -->
      <div class="mt-6 max-w-md mx-auto">
        <input
          type="text"
          id="suburb-filter-input"
          oninput="filterSuburbs(this.value)"
          placeholder="Search your suburb (e.g. Surfers Paradise, Robina, Burleigh)..."
          class="w-full px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-white/15 text-sm sm:text-base text-slate-900 dark:text-white focus:outline-none focus:border-blue-500"
        />
      </div>
    </div>

    <!-- Restrained Suburb Grid -->
    <div id="suburbs-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 text-center">
      
      <div class="suburb-pill glass-box p-3.5 rounded-2xl cursor-pointer hover:border-blue-500 transition-all" onclick="selectSuburbForQuote('Surfers Paradise (4217)')">
        <div class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">Surfers Paradise</div>
        <div class="text-xs text-blue-600 dark:text-cyan-400 font-bold">4217 • Primary</div>
      </div>

      <div class="suburb-pill glass-box p-3.5 rounded-2xl cursor-pointer hover:border-blue-500 transition-all" onclick="selectSuburbForQuote('Southport (4215)')">
        <div class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">Southport</div>
        <div class="text-xs text-emerald-600 dark:text-emerald-400 font-bold">4215 • Covered</div>
      </div>

      <div class="suburb-pill glass-box p-3.5 rounded-2xl cursor-pointer hover:border-blue-500 transition-all" onclick="selectSuburbForQuote('Broadbeach (4218)')">
