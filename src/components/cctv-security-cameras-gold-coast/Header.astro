---
// Component: Header.astro for CCTV Security Cameras Gold Coast
---
<!-- TOP UNIFIED STICKY NAVBAR WRAPPER -->
<div class="sticky top-0 z-50 shadow-md">
  
  <!-- TOP DISPATCH & COMPLIANCE ANNOUNCEMENT BAR -->
  <aside aria-label="Official Notice" class="bg-slate-950 border-b border-slate-800/80 text-slate-300 text-xs py-2 px-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5 min-w-0">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-black bg-blue-500/20 text-blue-400 border border-blue-500/30 tracking-wider shrink-0">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-ping"></span>
          LICENSED QLD INSTALLER
        </span>
        <span class="text-slate-300 font-medium text-xs hidden sm:inline truncate">
          Gold Coast, Surfers Paradise &amp; Surrounds
        </span>
        <span class="text-emerald-400 font-bold text-xs hidden lg:inline whitespace-nowrap">
          ✓ ACMA Open Registered Cabler • $20M Insured • 5-Yr Workmanship
        </span>
      </div>

      <div class="flex items-center gap-3 sm:gap-4 shrink-0 text-xs font-medium ml-auto">
        <a href="tel:+61447266455" class="hover:text-blue-400 text-white font-black flex items-center gap-1.5 transition-colors whitespace-nowrap">
          <svg class="w-3.5 h-3.5 text-blue-400" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
          <span>0447 266 455</span>
        </a>
        <span class="text-slate-700 hidden sm:inline">|</span>
        <a href="#quote" class="text-blue-400 hover:text-blue-300 font-bold hidden sm:inline whitespace-nowrap">
          Get Itemized Quote &rarr;
        </a>
      </div>
    </div>
  </aside>

  <!-- 1. GLOBAL HEADER & NAVIGATION -->
  <header id="main-header" class="bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl border-b border-slate-200 dark:border-white/10 transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-3 lg:gap-4">
      
      <!-- Brand Logo / Typographic Link -->
      <a href="/" class="flex flex-col shrink-0 group py-1 select-none" aria-label="Computers Gold Coast">
        <span class="font-black text-lg sm:text-xl tracking-tight text-slate-900 dark:text-white leading-tight group-hover:opacity-90 transition-opacity">
          Computers <span class="text-sky-500 dark:text-cyan-400">Gold Coast</span>
        </span>
        <span class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 font-medium tracking-normal mt-0.5">
          Local Computer &amp; Laptop Repairs
        </span>
      </a>

      <!-- Desktop Navlinks -->
      <nav class="hidden lg:flex items-center gap-6 xl:gap-8 text-sm xl:text-base font-bold text-slate-600 dark:text-slate-300">
        <a href="/#about" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors whitespace-nowrap">About Us</a>
        <a href="/services" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors whitespace-nowrap">Services</a>
        <a href="/#testimonials" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors whitespace-nowrap">Reviews</a>
        <a href="/contact" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors whitespace-nowrap">Contact</a>
      </nav>

      <!-- Actions & Theme Toggle -->
      <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
        <!-- Theme Toggle Switcher -->
        <button onclick="toggleTheme()" class="p-2 sm:p-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:border-blue-400 transition-all flex items-center justify-center cursor-pointer" aria-label="Toggle theme">
          <svg class="theme-icon-moon w-4 h-4 inline dark:hidden text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
          <svg class="theme-icon-sun w-4 h-4 hidden dark:inline text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </button>

        <!-- Primary CTA -->
        <a href="/contact" class="px-5 xl:px-6 py-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white text-xs font-black uppercase tracking-wider shadow-lg shadow-blue-600/30 transition-all hidden sm:inline-flex items-center gap-2 transform hover:-translate-y-0.5 whitespace-nowrap">
          Contact Us
        </a>

        <!-- Mobile Menu Hamburger -->
        <button onclick="toggleMobileMenu()" class="p-2 sm:p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 lg:hidden cursor-pointer" aria-label="Toggle menu">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/></svg>
        </button>
      </div>

    </div>

    <!-- Mobile Drawer -->
    <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 dark:border-white/10 bg-white dark:bg-slate-900 px-6 py-5 space-y-4 shadow-2xl">
      <div class="grid grid-cols-2 gap-3 text-xs font-bold text-slate-700 dark:text-slate-300">
        <a href="/#about" onclick="toggleMobileMenu()" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800">About Us</a>
        <a href="/services" onclick="toggleMobileMenu()" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800">Services</a>
        <a href="/#testimonials" onclick="toggleMobileMenu()" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800">Reviews</a>
        <a href="/contact" onclick="toggleMobileMenu()" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800">Contact</a>
      </div>
      <div class="pt-2 flex flex-col gap-2">
        <a href="/contact" onclick="toggleMobileMenu()" class="w-full py-3.5 rounded-xl bg-blue-600 text-white text-center font-black text-xs uppercase tracking-wider shadow-lg shadow-blue-600/30">
          Contact Us
        </a>
        <a href="tel:+61447266455" class="w-full py-3 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white text-center font-bold text-xs flex items-center justify-center gap-2">
          Call 0447 266 455
        </a>
      </div>
    </div>
  </header>
</div>
